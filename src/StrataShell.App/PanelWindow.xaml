<Window x:Class="StrataShell.App.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:StrataShell.App.ViewModels"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="StrataShell Panel"
        Icon="Assets/StrataShell.ico"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True" Background="#F20A0E17" AllowsTransparency="True"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <sys:Double x:Key="TileExtent">112</sys:Double>
        <Style x:Key="PanelIconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#1FFFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="18" />
        </Style>
        <Style x:Key="TileStyle" TargetType="ListBoxItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="Width" Value="{DynamicResource TileExtent}" />
            <Setter Property="Height" Value="118" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Tile" Background="{TemplateBinding Background}"
                                CornerRadius="15" Padding="10">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tile" Property="Background" Value="#26FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Tile" Property="Background" Value="#3D8AA7FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Opacity="0">
        <Grid.Background>
            <RadialGradientBrush Center="0.16,0.12" GradientOrigin="0.16,0.12" RadiusX="1.05" RadiusY="1.05">
                <GradientStop Color="#283F5F" Offset="0" />
                <GradientStop Color="#151D31" Offset="0.43" />
                <GradientStop Color="#090D16" Offset="1" />
            </RadialGradientBrush>
        </Grid.Background>

        <Ellipse Width="720" Height="720" HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-300,-220,0" Fill="#205E86FF" IsHitTestVisible="False" />
        <Ellipse Width="520" Height="520" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                 Margin="-170,0,0,-280" Fill="#1747D2C5" IsHitTestVisible="False" />

        <Grid Margin="64,42,64,38">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="S T R A T A S H E L L" FontSize="12" FontWeight="SemiBold"
                               Foreground="#9CB2D6" />
                    <TextBlock Text="Your space, at a glance." FontSize="30" FontWeight="SemiBold"
                               Margin="0,7,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <StackPanel Margin="0,0,22,0" VerticalAlignment="Center">
                        <TextBlock x:Name="ClockText" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        <TextBlock x:Name="DateText" FontSize="12" Foreground="#AEB7C9" HorizontalAlignment="Right" />
                    </StackPanel>
                    <Button Style="{StaticResource PanelIconButton}" ToolTip="Settings"
                            AutomationProperties.Name="Open StrataShell settings"
                            Click="SettingsButton_Click" Margin="0,0,10,0">
                        <TextBlock Text="⚙" />
                    </Button>
                    <Button Style="{StaticResource PanelIconButton}" ToolTip="Close"
                            AutomationProperties.Name="Close full-screen panel"
                            Click="CloseButton_Click">
                        <TextBlock Text="✕" />
                    </Button>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Width="620" MaxWidth="620" HorizontalAlignment="Left" Margin="0,32,0,24"
                    Background="#D91B2231" BorderBrush="#26FFFFFF" BorderThickness="1"
                    CornerRadius="16" Padding="18,12">
                <DockPanel>
                    <TextBlock Text="⌕" FontSize="24" Foreground="#B8C4D9" Margin="0,-3,12,0" />
                    <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0"
                             AutomationProperties.Name="Search applications"
                             AutomationProperties.HelpText="Type to filter the applications shown below"
                             Foreground="#F7F9FF" CaretBrush="#F7F9FF" FontSize="17"
                             FontFamily="Segoe UI Variable Text" TextChanged="SearchBox_TextChanged"
                             ToolTip="Search apps" />
                </DockPanel>
            </Border>

            <Grid Grid.Row="2">
                <TextBlock Text="All apps" FontSize="16" FontWeight="SemiBold"
                           VerticalAlignment="Top" Margin="4,0,0,0" />
                <TextBlock x:Name="LoadingText" Text="Loading your apps…" FontSize="16"
                           Foreground="#AEB7C9" VerticalAlignment="Center" HorizontalAlignment="Center" />
                <ListBox x:Name="AppsList" Background="Transparent" BorderThickness="0"
                         AutomationProperties.Name="Applications"
                         Margin="0,36,0,0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ItemContainerStyle="{StaticResource TileStyle}"
                         PreviewMouseLeftButtonUp="AppsList_MouseLeftButtonUp"
                         PreviewMouseRightButtonUp="AppsList_MouseRightButtonUp">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:AppTileViewModel}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="68" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Width="58" Height="58" CornerRadius="14" Background="#18FFFFFF"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Grid>
                                        <TextBlock Text="{Binding Initial}" FontSize="25" FontWeight="SemiBold"
                                                   Foreground="#9CB9FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Image Source="{Binding Icon}" Width="48" Height="48" Stretch="Uniform" />
                                    </Grid>
                                </Border>
                                <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="12.5"
                                           TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Top" MaxHeight="36" />
                                <TextBlock x:Name="PinGlyph" Text="★" Foreground="#FFD36A" FontSize="13"
                                           HorizontalAlignment="Right" VerticalAlignment="Top"
                                           Visibility="Collapsed" />
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                    <Setter TargetName="PinGlyph" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <Grid Grid.Row="3" Margin="0,20,0,0">
                <TextBlock x:Name="AppCountText" Foreground="#8F9CB1" FontSize="12" />
                <TextBlock Text="Esc closes  •  Enter opens  •  bare Windows key toggles"
                           Foreground="#8F9CB1" FontSize="12" HorizontalAlignment="Right" />
            </Grid>
        </Grid>
    </Grid>
</Window>
