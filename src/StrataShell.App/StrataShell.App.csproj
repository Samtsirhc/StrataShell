<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>StrataShell</AssemblyName>
    <RootNamespace>StrataShell.App</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\StrataShell.Core\StrataShell.Core.csproj" />
    <ProjectReference Include="..\StrataShell.Windows\StrataShell.Windows.csproj" />
    <ProjectReference Include="..\StrataShell.Watchdog\StrataShell.Watchdog.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyWatchdogArtifacts" AfterTargets="Build">
    <ItemGroup>
      <WatchdogArtifacts Include="..\StrataShell.Watchdog\bin\$(Configuration)\net8.0-windows10.0.19041.0\StrataShell.Watchdog.exe" />
      <WatchdogArtifacts Include="..\StrataShell.Watchdog\bin\$(Configuration)\net8.0-windows10.0.19041.0\StrataShell.Watchdog.dll" />
      <WatchdogArtifacts Include="..\StrataShell.Watchdog\bin\$(Configuration)\net8.0-windows10.0.19041.0\StrataShell.Watchdog.deps.json" />
      <WatchdogArtifacts Include="..\StrataShell.Watchdog\bin\$(Configuration)\net8.0-windows10.0.19041.0\StrataShell.Watchdog.runtimeconfig.json" />
    </ItemGroup>
    <Copy SourceFiles="@(WatchdogArtifacts)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
