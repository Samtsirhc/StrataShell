<Window x:Class="StrataShell.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StrataShell Settings" Width="940" Height="720" MinWidth="820" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBackgroundBrush}"
        Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="22" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Margin" Value="0,8,0,4" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinWidth" Value="180" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="0,6,0,4" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="Transparent" CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource CardBackgroundBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource CardHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="#111724" BorderBrush="#20283A" BorderThickness="0,0,0,1" Padding="28,20">
            <Grid>
                <StackPanel>
                    <TextBlock Text="StrataShell" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="A full-screen home and flexible taskbar for Windows 11"
                               Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0" />
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#183DDC97"
                        CornerRadius="12" Padding="12,7">
                    <TextBlock Text="●  Running" Foreground="#74E7B8" FontWeight="SemiBold" />
                </Border>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="24,12,24,0">
            <TabItem Header="Overview">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,18,8,12">
                    <StackPanel>
                        <Border Style="{StaticResource SectionCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Full-screen application space" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock Text="A modern, monitor-filling launcher with search, real app icons, and keyboard navigation."
                                               Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,8,28,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Open preview" Style="{StaticResource PrimaryButtonStyle}"
                                        Click="PreviewButton_Click" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="Recovery-first taskbar" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="Adjustable height, wrapping window buttons, quick launch, and notification icons. Explorer remains available as the safe recovery shell."
                                           Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="Current configuration" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock x:Name="OverviewSummaryText" Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Panel">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,18,8,12">
                    <StackPanel>
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="Behavior" FontSize="18" FontWeight="SemiBold" />
                                <CheckBox x:Name="PanelEnabledCheckBox" Content="Enable the full-screen panel" />
                                <CheckBox x:Name="WindowsKeyCheckBox" Content="Toggle on a bare Windows-key press" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="Layout and appearance" FontSize="18" FontWeight="SemiBold" />
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Tile size" />
                                    <TextBlock Grid.Column="1" Text="{Binding ElementName=TileSizeSlider, Path=Value, StringFormat={}{0:F0} px}" HorizontalAlignment="Right" />
                                </Grid>
                                <Slider x:Name="TileSizeSlider" Minimum="64" Maximum="140" TickFrequency="4" />
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Background opacity" />
                                    <TextBlock Grid.Column="1" Text="{Binding ElementName=PanelOpacitySlider, Path=Value, StringFormat={}{0:P0}}" HorizontalAlignment="Right" />
                                </Grid>
                                <Slider x:Name="PanelOpacitySlider" Minimum="0.72" Maximum="1" TickFrequency="0.02" />
                                <TextBlock Text="Motion" Margin="0,14,0,0" />
                                <ComboBox x:Name="MotionComboBox" HorizontalAlignment="Left">
                                    <ComboBoxItem Content="Reduced" /><ComboBoxItem Content="Full" />
                                </ComboBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Taskbar">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,18,8,12">
                    <StackPanel>
                        <Border Background="#292318" BorderBrush="#5A4524" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,16">
                            <TextBlock Text="The custom taskbar temporarily replaces the visible Explorer taskbar. If initialization fails or StrataShell exits, Explorer is restored automatically."
                                       Foreground="#F2CD83" TextWrapping="Wrap" />
                        </Border>
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="Behavior" FontSize="18" FontWeight="SemiBold" />
                                <CheckBox x:Name="TaskbarEnabledCheckBox" Content="Enable the custom taskbar" />
                                <CheckBox x:Name="AutoHideCheckBox" Content="Automatically hide" />
                                <CheckBox x:Name="QuickLaunchCheckBox" Content="Show quick-launch shortcuts" />
                                <CheckBox x:Name="NotificationAreaCheckBox" Content="Show notification icons" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="Dimensions" FontSize="18" FontWeight="SemiBold" />
                                <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Total height"/><TextBlock Grid.Column="1" Text="{Binding ElementName=TaskbarHeightSlider, Path=Value, StringFormat={}{0:F0} px}" HorizontalAlignment="Right"/></Grid>
                                <Slider x:Name="TaskbarHeightSlider" Minimum="48" Maximum="180" TickFrequency="4" />
                                <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Window rows"/><TextBlock Grid.Column="1" Text="{Binding ElementName=TaskbarRowsSlider, Path=Value, StringFormat={}{0:F0}}" HorizontalAlignment="Right"/></Grid>
                                <Slider x:Name="TaskbarRowsSlider" Minimum="1" Maximum="4" TickFrequency="1" IsSnapToTickEnabled="True" />
                                <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Icon size"/><TextBlock Grid.Column="1" Text="{Binding ElementName=TaskbarIconSizeSlider, Path=Value, StringFormat={}{0:F0} px}" HorizontalAlignment="Right"/></Grid>
                                <Slider x:Name="TaskbarIconSizeSlider" Minimum="20" Maximum="48" TickFrequency="2" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Startup &amp; diagnostics">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,18,8,12">
                    <StackPanel>
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="Lifecycle" FontSize="18" FontWeight="SemiBold" />
                                <CheckBox x:Name="RunAtStartupCheckBox" Content="Run when I sign in" />
                                <CheckBox x:Name="StartQuietlyCheckBox" Content="Start quietly in the notification area" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="Settings file" FontSize="18" FontWeight="SemiBold" />
                                <TextBox x:Name="SettingsPathTextBox" IsReadOnly="True" Margin="0,12,0,0"
                                         Padding="10" Background="#0E1320" Foreground="{StaticResource SecondaryTextBrush}"
                                         BorderBrush="#2A344A" TextWrapping="Wrap" />
                                <TextBlock Text="Settings are versioned and written atomically. No administrator rights are required."
                                           Foreground="{StaticResource SecondaryTextBrush}" Margin="0,10,0,0" TextWrapping="Wrap" />
                                <WrapPanel Margin="0,18,0,0">
                                    <Button Content="Open diagnostics" Click="OpenDiagnosticsButton_Click" Margin="0,0,10,10" />
                                    <Button Content="Check releases" Click="CheckReleasesButton_Click" Margin="0,0,10,10" />
                                    <Button Content="Reset safe defaults" Click="ResetButton_Click" Margin="0,0,10,10" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="#111724" BorderBrush="#20283A" BorderThickness="0,1,0,0" Padding="24,15">
            <Grid>
                <TextBlock x:Name="StatusTextBlock" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Hide to tray" Click="HideButton_Click" Margin="0,0,10,0" />
                    <Button Content="Save changes" Click="SaveButton_Click" Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
